# ===== Пресет переменных окружения для db_manager / api =====
# Скопируйте в .env и при необходимости измените.

# --- БД ---
DB_PATH=users.db
PASSWORDS_FILE=passwords.txt
BCRYPT_ROUNDS=12
ACTIVE_USERS_MAXLEN=5

# --- HTTP API ---
API_HOST=127.0.0.1
API_PORT=5000
API_DEBUG=0

# LLM (для расширения проекта)
LLM_BASE_URL=https://api.aitunnel.ru/v1
LLM_MODEL=minimax-m3